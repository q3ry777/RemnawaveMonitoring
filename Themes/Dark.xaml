<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Bg" Color="#0A0C0F"/>
    <SolidColorBrush x:Key="BgAlt" Color="#12151A"/>
    <SolidColorBrush x:Key="Panel" Color="#15181E"/>
    <SolidColorBrush x:Key="Line" Color="#242832"/>
    <SolidColorBrush x:Key="Fg" Color="#E9ECEF"/>
    <SolidColorBrush x:Key="Dim" Color="#7D8494"/>
    <SolidColorBrush x:Key="Amber" Color="#FFB020"/>
    <SolidColorBrush x:Key="AmberFg" Color="#141414"/>
    <SolidColorBrush x:Key="Green" Color="#4ADE80"/>
    <SolidColorBrush x:Key="Red" Color="#FB4934"/>
    <SolidColorBrush x:Key="RedTint" Color="#22FB4934"/>
    <SolidColorBrush x:Key="AmberTint" Color="#22FFB020"/>
    <Color x:Key="GlowGreen">#4ADE80</Color>
    <RadialGradientBrush x:Key="Glow" Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.7" RadiusY="1">
        <GradientStop Color="#10FFB020" Offset="0"/>
        <GradientStop Color="#00FFB020" Offset="1"/>
    </RadialGradientBrush>
    <DrawingBrush x:Key="Scan" TileMode="Tile" Viewport="0,0,3,3" ViewportUnits="Absolute"
                  Viewbox="0,0,3,3" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#05FFFFFF">
                <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,3,1"/></GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>
</ResourceDictionary>
