<Window x:Class="RemnawaveMonitor.IncidentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="журнал событий" Width="900" Height="560" MinWidth="720" MinHeight="380"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        FontFamily="{StaticResource Mono}" FontSize="13" UseLayoutRounding="True">
    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="15" FontWeight="Bold">
                <Run Text="журнал событий"/><Run Text="_" Foreground="{DynamicResource Amber}"/>
            </TextBlock>
            <TextBlock x:Name="SummaryText" Foreground="{DynamicResource Dim}" FontSize="12" Margin="0,8,0,14"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="22,12,30,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22"/><ColumnDefinition Width="110"/><ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="170"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="НАЧАЛО" Style="{StaticResource Hdr}"/>
                        <TextBlock Grid.Column="2" Text="ОБЪЕКТ" Style="{StaticResource Hdr}"/>
                        <TextBlock Grid.Column="3" Text="СОБЫТИЕ" Style="{StaticResource Hdr}"/>
                        <TextBlock Grid.Column="4" Text="СОСТОЯНИЕ" Style="{StaticResource Hdr}"/>
                    </Grid>
                </Border>
                <ListBox x:Name="IncList" Grid.Row="1" Style="{StaticResource Rows}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource Row}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Unread}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AmberTint}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/><ColumnDefinition Width="110"/><ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="170"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,4,0,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource Dim}"/>
                                                <Setter Property="Opacity" Value="0.5"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="bad">
                                                        <Setter Property="Fill" Value="{DynamicResource Red}"/>
                                                        <Setter Property="Opacity" Value="1"/>
                                                        <Setter Property="Effect">
                                                            <Setter.Value><DropShadowEffect ShadowDepth="0" BlurRadius="10" Color="#FB4934" Opacity="1"/></Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="warn">
                                                        <Setter Property="Fill" Value="{DynamicResource Amber}"/>
                                                        <Setter Property="Opacity" Value="1"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Grid.Column="1" Text="{Binding Time}" Foreground="{DynamicResource Dim}" FontSize="12"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Subject}" FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                        <Border Margin="8,0,0,0" Padding="5,0" CornerRadius="3" BorderThickness="1" BorderBrush="{DynamicResource Amber}" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Unread}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="NEW" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Amber}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="{Binding Text}" FontSize="12" TextWrapping="Wrap" Margin="0,0,16,0"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Status}" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Green}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="bad"><Setter Property="Foreground" Value="{DynamicResource Red}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="warn"><Setter Property="Foreground" Value="{DynamicResource Amber}"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyText" Grid.Row="1" Text="событий пока нет — всё спокойно" Foreground="{DynamicResource Dim}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="очистить решённые" Style="{StaticResource Btn}" Click="Clear_Click"/>
            <Button Content="закрыть" Style="{StaticResource Btn}" Click="Close_Click"/>
            <Button Content="всё прочитано" Style="{StaticResource BtnPrimary}" Click="AckAll_Click"/>
        </StackPanel>
    </Grid>
</Window>
