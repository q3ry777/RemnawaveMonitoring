<Window x:Class="RemnawaveMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RemnawaveMonitor"
        Title="remna-monitor" Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        FontFamily="{StaticResource Mono}" FontSize="13" MinWidth="960" MinHeight="480"
        UseLayoutRounding="True" WindowStartupLocation="CenterScreen">
    <Window.Resources><local:FlagConverter x:Key="Flag"/></Window.Resources>
    <Grid>
        <Rectangle Fill="{DynamicResource Glow}" Height="320" VerticalAlignment="Top" IsHitTestVisible="False"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- header -->
            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="28,20">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="JournalBtn" Content="журнал" Style="{StaticResource Btn}" Click="Journal_Click"/>
                        <Button Content="◐ тема" Style="{StaticResource Btn}" Click="Theme_Click"/>
                        <Button Content="настройки" Style="{StaticResource Btn}" Click="Settings_Click"/>
                        <Button x:Name="RefreshBtn" Content="обновить" Style="{StaticResource BtnPrimary}" Click="Refresh_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontSize="15" FontWeight="Bold" VerticalAlignment="Center">
                            <Run Text="remna"/><Run Text="-" Foreground="{DynamicResource Amber}"/><Run Text="monitor"/>
                        </TextBlock>
                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="3" Padding="9,3" Margin="12,0,0,0">
                            <TextBlock x:Name="VersionBadge" Text="V" FontSize="11" Foreground="{DynamicResource Dim}"/>
                        </Border>
                        <Border x:Name="UpdateChip" Visibility="Collapsed" Cursor="Hand" Margin="10,0,0,0" Padding="9,3" CornerRadius="10"
                                BorderThickness="1" BorderBrush="{DynamicResource Amber}" Background="{DynamicResource AmberTint}"
                                MouseLeftButtonUp="UpdateChip_Click" ToolTip="открыть страницу релизов">
                            <TextBlock x:Name="UpdateText" FontSize="11" Foreground="{DynamicResource Amber}"/>
                        </Border>
                        <Border x:Name="AppUpdateChip" Visibility="Collapsed" Cursor="Hand" Margin="10,0,0,0" Padding="9,3" CornerRadius="10"
                                BorderThickness="1" BorderBrush="{DynamicResource Green}" Background="{DynamicResource Panel}"
                                MouseLeftButtonUp="AppUpdateChip_Click" ToolTip="скачать и установить новую версию программы">
                            <TextBlock x:Name="AppUpdateText" FontSize="11" Foreground="{DynamicResource Green}"/>
                        </Border>
                        <Border x:Name="DndChip" Visibility="Collapsed" Margin="10,0,0,0" Padding="9,3" CornerRadius="10"
                                BorderThickness="1" BorderBrush="{DynamicResource Line}" Background="{DynamicResource Panel}"
                                ToolTip="уведомления в Telegram сейчас не отправляются · настройки → telegram">
                            <TextBlock x:Name="DndText" FontSize="11" Foreground="{DynamicResource Dim}"/>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- toolbar + фильтры + баннер -->
            <StackPanel Grid.Row="1" Margin="28,22,28,14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton x:Name="UsersTab" Content="пользователи" IsChecked="True" Style="{StaticResource PillTab}" Checked="Tab_Checked"/>
                        <RadioButton x:Name="NodesTab" Content="ноды" Style="{StaticResource PillTab}" Checked="Tab_Checked"/>
                    </StackPanel>
                    <Grid x:Name="SearchBox" DockPanel.Dock="Right" Width="250">
                        <TextBox x:Name="Search" Style="{StaticResource Input}" TextChanged="Search_Changed"/>
                        <TextBlock Text="поиск пользователя…" Foreground="{DynamicResource Dim}" Opacity="0.7" Margin="13,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=Search}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                        <Ellipse Style="{StaticResource PulseDot}" Width="7" Height="7" Fill="{DynamicResource Amber}" Margin="0,0,8,0">
                            <Ellipse.Effect><DropShadowEffect ShadowDepth="0" BlurRadius="8" Color="#FFB020" Opacity="0.9"/></Ellipse.Effect>
                        </Ellipse>
                        <TextBlock x:Name="OnlineText" Text="0 онлайн" Foreground="{DynamicResource Dim}" FontSize="12"/>
                        <Ellipse x:Name="NodesDot" Width="7" Height="7" Fill="{DynamicResource Dim}" Margin="22,0,8,0"/>
                        <TextBlock x:Name="NodesText" Text="ноды" Foreground="{DynamicResource Dim}" FontSize="12"/>
                    </StackPanel>
                </DockPanel>

                <StackPanel x:Name="UsersFilters" Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock Text="ФИЛЬТР" Style="{StaticResource Hdr}" VerticalAlignment="Center" Margin="2,0,12,0"/>
                    <ToggleButton x:Name="FilterOnline" Content="только онлайн" Style="{StaticResource PillToggle}" Click="Filter_Changed"/>
                    <ToggleButton x:Name="FilterProblem" Content="проблемные" Style="{StaticResource PillToggle}" Click="Filter_Changed"
                                  ToolTip="не ACTIVE, лимит трафика ≥80% или подписка скоро истекает"/>
                </StackPanel>

                <Border x:Name="Banner" Visibility="Collapsed" Margin="0,12,0,0" Padding="14,9" CornerRadius="8" BorderThickness="1"
                        Background="{DynamicResource RedTint}" BorderBrush="{DynamicResource Red}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource Red}" Margin="0,0,10,0"/>
                        <TextBlock x:Name="BannerText" Grid.Column="1" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- panel -->
            <Border Grid.Row="2" Margin="28,0,28,0" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}"
                    BorderThickness="1" CornerRadius="10" Padding="0,0,0,4">
                <Grid>
                    <!-- Пользователи -->
                    <Grid x:Name="UsersPanel">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="22,12,30,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="170"/><ColumnDefinition Width="180"/><ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="HdrName" Grid.Column="1" Tag="name" Style="{StaticResource HdrSort}" MouseLeftButtonUp="Sort_Click"/>
                                <TextBlock x:Name="HdrStatus" Grid.Column="2" Tag="status" Style="{StaticResource HdrSort}" MouseLeftButtonUp="Sort_Click"/>
                                <TextBlock x:Name="HdrTraffic" Grid.Column="3" Tag="traffic" Style="{StaticResource HdrSort}" MouseLeftButtonUp="Sort_Click"/>
                                <TextBlock x:Name="HdrNode" Grid.Column="4" Tag="node" Style="{StaticResource HdrSort}" MouseLeftButtonUp="Sort_Click"/>
                                <TextBlock x:Name="HdrOnline" Grid.Column="5" Tag="online" Style="{StaticResource HdrSort}" MouseLeftButtonUp="Sort_Click"/>
                            </Grid>
                        </Border>
                        <ListBox x:Name="UsersGrid" PreviewMouseRightButtonUp="List_RightClick" Grid.Row="1" Style="{StaticResource Rows}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Row}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="170"/><ColumnDefinition Width="180"/><ColumnDefinition Width="110"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="8" Height="8" HorizontalAlignment="Left">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource Dim}"/>
                                                        <Setter Property="Opacity" Value="0.45"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource Green}"/>
                                                                <Setter Property="Opacity" Value="1"/>
                                                                <Setter Property="Effect">
                                                                    <Setter.Value><DropShadowEffect ShadowDepth="0" BlurRadius="10" Color="#4ADE80" Opacity="1"/></Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBlock Text="{Binding Username}" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <Border CornerRadius="3" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ExpireLevel}" Value="warn">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Setter Property="Background" Value="{DynamicResource AmberTint}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ExpireLevel}" Value="crit">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Setter Property="Background" Value="{DynamicResource RedTint}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding ExpireNote}" FontSize="11">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource Amber}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ExpireLevel}" Value="crit"><Setter Property="Foreground" Value="{DynamicResource Red}"/></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="12" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource Red}"/>
                                                        <Style.Triggers><DataTrigger Binding="{Binding Status}" Value="ACTIVE"><Setter Property="Foreground" Value="{DynamicResource Green}"/></DataTrigger></Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Traffic}"/>
                                                <ProgressBar Style="{StaticResource Bar}" Value="{Binding TrafficPct, Mode=OneWay}" Margin="0,5,18,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Style="{StaticResource FlagImg}" Source="{Binding LastNodeCountry, Converter={StaticResource Flag}}"/>
                                                    <TextBlock Text="{Binding LastNode}" Foreground="{DynamicResource Dim}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Ip}" ToolTip="{Binding IpTip}" FontSize="11" Margin="0,3,0,0" Foreground="{DynamicResource Dim}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Ip}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                            <TextBlock Grid.Column="5" Text="{Binding Online}" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource Dim}"/>
                                                        <Style.Triggers><DataTrigger Binding="{Binding IsOnline}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Green}"/></DataTrigger></Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- Ноды -->
                    <Grid x:Name="NodesPanel" Visibility="Collapsed">
                        <ListBox x:Name="NodesGrid" PreviewMouseRightButtonUp="List_RightClick" Style="{StaticResource Rows}" Margin="0,4,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Row}" Padding="22,14,30,14">
                                        <StackPanel>
                                            <!-- строка 1: имя, статус, трафик, аптайм, люди -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="210"/><ColumnDefinition Width="150"/><ColumnDefinition Width="90"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="8" Height="8" HorizontalAlignment="Left">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{DynamicResource Red}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Connected}" Value="True">
                                                                    <Setter Property="Fill" Value="{DynamicResource Green}"/>
                                                                    <Setter Property="Effect">
                                                                        <Setter.Value><DropShadowEffect ShadowDepth="0" BlurRadius="10" Color="#4ADE80" Opacity="1"/></Setter.Value>
                                                                    </Setter>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Image Style="{StaticResource FlagImg}" Height="15" Source="{Binding Country, Converter={StaticResource Flag}}"/>
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>
                                                    <TextBlock Text="{Binding MutedText}" FontSize="11" Foreground="{DynamicResource Dim}" Margin="10,0,0,0"
                                                               VerticalAlignment="Center" ToolTip="уведомления отключены (ПКМ по ноде — включить)"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="12" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource Red}"/>
                                                            <Style.Triggers><DataTrigger Binding="{Binding Connected}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Green}"/></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TrafficText}"/>
                                                    <ProgressBar Style="{StaticResource Bar}" Value="{Binding TrafficPct, Mode=OneWay}" Margin="0,5,22,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="4" Text="{Binding Xray}" FontSize="12" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource Red}"/>
                                                            <Style.Triggers><DataTrigger Binding="{Binding XrayOk}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Fg}"/></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Border Grid.Column="5" HorizontalAlignment="Left" VerticalAlignment="Center" BorderBrush="{DynamicResource Line}"
                                                        BorderThickness="1" CornerRadius="10" Padding="9,2">
                                                    <TextBlock Text="{Binding UsersOnline, StringFormat='онлайн {0}'}" FontSize="11" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>

                                            <!-- строка 2: CPU, память, диск сервера и скорость -->
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22"/><ColumnDefinition Width="190"/><ColumnDefinition Width="190"/>
                                                    <ColumnDefinition Width="190"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Background="Transparent" ToolTip="{Binding CpuTip}">
                                                    <TextBlock Text="CPU" Style="{StaticResource MeterLbl}"/>
                                                    <ProgressBar Style="{StaticResource MeterBar}" Value="{Binding CpuVal, Mode=OneWay}" Tag="{Binding CpuLevel}"/>
                                                    <TextBlock Text="{Binding CpuPctText}" Style="{StaticResource MeterPct}" Tag="{Binding CpuLevel}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Background="Transparent" ToolTip="{Binding RamTip}">
                                                    <TextBlock Text="RAM" Style="{StaticResource MeterLbl}"/>
                                                    <ProgressBar Style="{StaticResource MeterBar}" Value="{Binding RamVal, Mode=OneWay}" Tag="{Binding RamLevel}"/>
                                                    <TextBlock Text="{Binding RamPctText}" Style="{StaticResource MeterPct}" Tag="{Binding RamLevel}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" Background="Transparent" ToolTip="{Binding DiskTip}">
                                                    <TextBlock Text="ДИСК" Style="{StaticResource MeterLbl}"/>
                                                    <ProgressBar Style="{StaticResource MeterBar}" Value="{Binding DiskVal, Mode=OneWay}" Tag="{Binding DiskLevel}"/>
                                                    <TextBlock Text="{Binding DiskPctText}" Style="{StaticResource MeterPct}" Tag="{Binding DiskLevel}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="4" Text="{Binding Down}" FontSize="12" Foreground="{DynamicResource Green}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="5" Text="{Binding Up}" FontSize="12" Foreground="{DynamicResource Amber}" VerticalAlignment="Center"/>
                                            </Grid>
                                            <!-- строка 3: версии и оплата -->
                                            <Grid Margin="0,8,0,0">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding VersionText}" Value=""/>
                                                                    <Condition Binding="{Binding BillingText}" Value=""/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="1" Text="{Binding VersionText}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,10,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource Dim}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding VersionLevel}" Value="warn"><Setter Property="Foreground" Value="{DynamicResource Amber}"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Column="2" Text="{Binding BillingText}" FontSize="12" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource Dim}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding BillingLevel}" Value="warn"><Setter Property="Foreground" Value="{DynamicResource Amber}"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding BillingLevel}" Value="crit"><Setter Property="Foreground" Value="{DynamicResource Red}"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                            <!-- строка 4: ошибка сбора статистики по SSH -->
                                            <TextBlock Text="{Binding SrvNote}" FontSize="12" Foreground="{DynamicResource Red}" Margin="22,8,0,0"
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SrvNote}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                </Grid>
            </Border>

            <!-- footer -->
            <Border Grid.Row="3" Margin="0,16,0,0" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="28,13">
                <DockPanel>
                    <TextBlock x:Name="StatusText" DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource Dim}"/>
                    <TextBlock Text="© 2026 broken-tech — remna-monitor" FontSize="11" Foreground="{DynamicResource Dim}"/>
                </DockPanel>
            </Border>
        </Grid>

        <Rectangle Fill="{DynamicResource Scan}" IsHitTestVisible="False"/>
    </Grid>
</Window>
