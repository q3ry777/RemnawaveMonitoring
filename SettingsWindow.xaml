<Window x:Class="RemnawaveMonitor.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="настройки" Width="480" SizeToContent="Height" MaxHeight="780" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        FontFamily="{StaticResource Mono}" FontSize="13">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="26,22,26,22">
            <TextBlock FontSize="15" FontWeight="Bold">
                <Run Text="настройки"/><Run Text="_" Foreground="{DynamicResource Amber}"/>
            </TextBlock>

            <TextBlock Text="URL ПАНЕЛИ" Style="{StaticResource Hdr}" Margin="0,20,0,6"/>
            <TextBox x:Name="Url" Style="{StaticResource Input}"/>

            <TextBlock Text="API-ТОКЕН (хранится зашифрованным)" Style="{StaticResource Hdr}" Margin="0,14,0,6"/>
            <PasswordBox x:Name="Token" Style="{StaticResource InputPwd}"/>

            <TextBlock Text="ИНТЕРВАЛ ОБНОВЛЕНИЯ, СЕК" Style="{StaticResource Hdr}" Margin="0,14,0,6"/>
            <TextBox x:Name="Interval" Style="{StaticResource Input}"/>

            <TextBlock Text="СЧИТАТЬ ОНЛАЙН, ЕСЛИ БЫЛ АКТИВЕН ПОСЛЕДНИЕ, СЕК" Style="{StaticResource Hdr}" Margin="0,14,0,6"/>
            <TextBox x:Name="OnlineBox" Style="{StaticResource Input}"/>

            <TextBlock Text="PROMETHEUS /metrics (для нагрузки нод)" Style="{StaticResource Hdr}" Margin="0,22,0,6"/>
            <TextBox x:Name="MetricsUrlBox" Style="{StaticResource Input}"/>
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBox x:Name="MetricsUserBox" Style="{StaticResource Input}" ToolTip="логин Basic Auth"/>
                <PasswordBox x:Name="MetricsPassBox" Grid.Column="2" Style="{StaticResource InputPwd}" ToolTip="пароль Basic Auth"/>
            </Grid>
            <Button Content="сохранить /metrics в файл" Style="{StaticResource Btn}" Margin="0,10,0,0"
                    HorizontalAlignment="Left" Click="Dump_Click"/>

            <TextBlock Text="ПРОВЕРКА НОД С ЭТОГО ПК" Style="{StaticResource Hdr}" Margin="0,22,0,8"/>
            <CheckBox x:Name="ProbeBox" Style="{StaticResource Check}" Content="проверять ping и порт каждой ноды"/>
            <CheckBox x:Name="RuBox" Style="{StaticResource Check}" Margin="0,12,0,0"
                      Content="проверять доступность из России (check-host.net)"
                      ToolTip="раз в 10 минут адрес и порт каждой ноды отправляются на check-host.net"/>
            <TextBlock Text="ПОРТ ДЛЯ ПРОВЕРКИ (0 — только ping)" Style="{StaticResource Hdr}" Margin="0,12,0,6"/>
            <TextBox x:Name="ProbePortBox" Style="{StaticResource Input}"/>

            <TextBlock Text="САЙТЫ ДЛЯ ВКЛАДКИ «СЕРВИСЫ» (по одному в строке)" Style="{StaticResource Hdr}" Margin="0,22,0,6"/>
            <TextBox x:Name="ServicesBox" Style="{StaticResource Input}" AcceptsReturn="True" Height="120"
                     VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>

            <TextBlock x:Name="UpdVerText" Style="{StaticResource Hdr}" Margin="0,22,0,6"/>
            <TextBlock Text="РЕПОЗИТОРИЙ GITHUB (owner/repo)" Style="{StaticResource Hdr}" Margin="0,0,0,6"/>
            <TextBox x:Name="UpdateRepoBox" Style="{StaticResource Input}"/>
            <TextBlock Text="ТОКЕН ТОЛЬКО НА ЧТЕНИЕ (Contents: Read)" Style="{StaticResource Hdr}" Margin="0,12,0,6"/>
            <PasswordBox x:Name="UpdateTokenBox" Style="{StaticResource InputPwd}"/>
            <Button Content="проверить обновления" Style="{StaticResource Btn}" Margin="0,10,0,0"
                    HorizontalAlignment="Left" Click="CheckUpdate_Click"/>

            <TextBlock Text="TELEGRAM" Style="{StaticResource Hdr}" Margin="0,22,0,8"/>
            <CheckBox x:Name="TgBox" Style="{StaticResource Check}" Content="отправлять уведомления в Telegram"/>
            <TextBlock Text="ТОКЕН БОТА (от @BotFather; хранится зашифрованным)" Style="{StaticResource Hdr}" Margin="0,12,0,6"/>
            <PasswordBox x:Name="TgTokenBox" Style="{StaticResource InputPwd}"/>
            <TextBlock Text="ID ЧАТА (сначала напишите боту любое сообщение)" Style="{StaticResource Hdr}" Margin="0,12,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="TgChatBox" Style="{StaticResource Input}"/>
                <Button Grid.Column="1" Content="привязать чат" Style="{StaticResource Btn}" Click="TgBind_Click"/>
            </Grid>
            <TextBlock Text="ПРОКСИ (необязательно): http://host:port или socks5://host:port" Style="{StaticResource Hdr}" Margin="0,12,0,6"/>
            <TextBox x:Name="TgProxyBox" Style="{StaticResource Input}"/>
            <TextBlock Text="ЧТО ПРИСЫЛАТЬ" Style="{StaticResource Hdr}" Margin="0,14,0,4"/>
            <CheckBox x:Name="TgNodesBox" Style="{StaticResource Check}" Margin="0,6,0,0" Content="ноды и связь с панелью"/>
            <CheckBox x:Name="TgServicesBox" Style="{StaticResource Check}" Margin="0,6,0,0" Content="сайты и сертификаты"/>
            <CheckBox x:Name="TgLimitsBox" Style="{StaticResource Check}" Margin="0,6,0,0" Content="лимиты трафика и подписки пользователей"/>
            <CheckBox x:Name="TgBillingBox" Style="{StaticResource Check}" Margin="0,6,0,0" Content="оплата серверов"/>
            <CheckBox x:Name="TgUpdatesBox" Style="{StaticResource Check}" Margin="0,6,0,0" Content="новые версии (панель, ноды, программа)"/>
            <Button Content="отправить тест" Style="{StaticResource Btn}" Margin="0,12,0,0" HorizontalAlignment="Left" Click="TgTest_Click"/>

            <TextBlock Text="ТЕМА" Style="{StaticResource Hdr}" Margin="0,22,0,8"/>
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="DarkRb" GroupName="theme" Content="тёмная" Style="{StaticResource PillTab}"/>
                <RadioButton x:Name="LightRb" GroupName="theme" Content="светлая" Style="{StaticResource PillTab}"/>
            </StackPanel>

            <CheckBox x:Name="AutoBox" Style="{StaticResource Check}" Margin="0,20,0,0"
                      Content="запускать вместе с Windows (свёрнуто в трей)"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Content="отмена" Style="{StaticResource Btn}" IsCancel="True"/>
                <Button Content="сохранить" Style="{StaticResource BtnPrimary}" IsDefault="True" Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
